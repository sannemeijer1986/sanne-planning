# Shared password required just to view the site at all. Give this only to
# people who should be able to see the planner.
VIEW_PASSWORD=

# Shared password that unlocks edit mode. Change this before deploying.
EDIT_PASSWORD=

# Random secret used to sign the session cookies (view + edit). Generate one with:
#   openssl rand -hex 32
AUTH_SECRET=

# Provided automatically once a Vercel Blob store is attached to the project.
# For local development, run `vercel link` then `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=

# Authorizes Vercel Cron's daily call to /api/backup. Generate one with:
#   openssl rand -hex 32
# Vercel sends it automatically as "Authorization: Bearer $CRON_SECRET" to
# cron-triggered requests once this env var is set on the project.
CRON_SECRET=
