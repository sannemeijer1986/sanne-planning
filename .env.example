# Shared password that unlocks edit mode. Change this before deploying.
EDIT_PASSWORD=

# Random secret used to sign the edit-mode session cookie. Generate one with:
#   openssl rand -hex 32
AUTH_SECRET=

# Provided automatically once a Vercel Blob store is attached to the project.
# For local development, run `vercel link` then `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
